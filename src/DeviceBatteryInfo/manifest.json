{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.pyflat.device-battery-info",
  "name": "Device Battery Info",
  "version": "1.4.1",
  "description": "Battery levels for your PC, phone, mouse and Bluetooth devices, with a custom deck widget.",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/DeviceBatteryInfo.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "osx-arm64": {
      "executable": "runtimes/osx-arm64/DeviceBatteryInfo.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  },
  "publisher": {
    "name": "PyFlat"
  },
  "license": "MIT",
  "permissions": [
    "host:adb"
  ],
  "ai": {
    "interaction": false,
    "generatedContent": false,
    "generatedAssets": false
  },
  "compatibility": {
    "macroDeck": ">=3.0.0-beta.12"
  },
  "repository": "https://github.com/PyFlat/Device-Battery-Info"
}