    </data>
    <data name="Variables.Trend.DisplayName" xml:space="preserve">
        <value>{device} battery trend</value>
    </data>
    <data name="Variables.Trend.Description" xml:space="preserve">
        <value>How much {device}'s charge has moved recently, as a signed percentage over the window it covers, for example -13%/1h or +28%/30m. Empty until enough history has built up.</value>
    </data>
    <data name="Variables.TrendRate.DisplayName" xml:space="preserve">
        <value>{device} battery rate</value>
    </data>
    <data name="Variables.TrendRate.Description" xml:space="preserve">
        <value>Signed rate of change for {device} in percent per hour, normalized from the same recent window as the battery trend.</value>
    </data>

