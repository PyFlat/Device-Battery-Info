<?xml version="1.0" encoding="utf-8"?>
<root>
    <!-- The default-language file. Every translation is checked against it and the fallback chain ends
       here, so it is required even for a plugin that ships one language. Add a language by adding
       Localization/Strings.<culture>.resx beside it (Strings.de.resx, Strings.pt-BR.resx).
       A dotted key becomes a nested class: Actions.Refresh.Name is Strings.Actions.Refresh.Name(). -->
    <resheader name="resmimetype">
        <value>text/microsoft-resx</value>
    </resheader>
    <resheader name="version">
        <value>2.0</value>
    </resheader>
    <resheader name="reader">
        <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
    </resheader>
    <resheader name="writer">
        <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
    </resheader>

    <data name="Actions.Refresh.Name" xml:space="preserve">
        <value>Refresh battery levels</value>
    </data>
    <data name="Actions.Refresh.Description" xml:space="preserve">
        <value>Polls every configured battery source now instead of waiting for the next interval.</value>
    </data>

    <data name="Variables.Percent.DisplayName" xml:space="preserve">
        <value>{device} battery level</value>
    </data>
    <data name="Variables.Percent.Description" xml:space="preserve">
        <value>Charge level of {device}, from 0 to 100.</value>
    </data>
    <data name="Variables.Status.DisplayName" xml:space="preserve">
        <value>{device} battery status</value>
    </data>
    <data name="Variables.Status.Description" xml:space="preserve">
