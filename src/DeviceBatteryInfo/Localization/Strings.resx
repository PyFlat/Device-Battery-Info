    </data>
    <data name="Variables.Charging.DisplayName" xml:space="preserve">
        <value>{device} is charging</value>
    </data>
    <data name="Variables.Charging.Description" xml:space="preserve">
        <value>True while {device} is charging.</value>
    </data>
    <data name="Variables.Online.DisplayName" xml:space="preserve">
        <value>{device} battery reachable</value>
    </data>
    <data name="Variables.Online.Description" xml:space="preserve">
        <value>True while {device} is returning a fresh reading.</value>
    </data>
    <data name="Variables.TimeToFull.DisplayName" xml:space="preserve">
        <value>{device} time to full</value>
    </data>
    <data name="Variables.TimeToFull.Description" xml:space="preserve">
